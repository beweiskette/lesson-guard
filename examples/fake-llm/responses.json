{
  "generated-client": {
    "guards": [
      {
        "id": "no-direct-edit-generated",
        "description": "Files with a generated-code header are edited through their generator, not by hand.",
        "severity": "block",
        "event": [
          "pre_edit"
        ],
        "match": {
          "predicates": [
            "file_is_generated_marker"
          ]
        },
        "message": "This file is generated. Change the schema or the generator (for example tools/generate_client.py) and rerun it instead of editing the output.",
        "tests": {
          "block": [
            {
              "path": "src/api/client_gen.py",
              "original": "# Code generated by tools/generate_client.py. DO NOT EDIT.\nclass Client:\n    pass\n",
              "content": "# Code generated by tools/generate_client.py. DO NOT EDIT.\nclass Client:\n    timeout = 5\n"
            },
            {
              "tool": "Edit",
              "path": "web/types.ts",
              "original": "// @generated by schema-tool\nexport type Id = string;\n",
              "added": "export type Id = number;"
            }
          ],
          "pass": [
            {
              "path": "src/api/client.py",
              "original": "class Client:\n    pass\n",
              "content": "class Client:\n    timeout = 5\n"
            },
            {
              "path": "docs/generator.md",
              "original": "How the generator works: it writes files you should not touch.\n",
              "content": "Updated docs.\n"
            },
            {
              "path": "src/api/new_module.py",
              "content": "print('new file')\n"
            }
          ]
        }
      }
    ]
  },
  "line-endings": {
    "guards": [
      {
        "id": "keep-mixed-line-endings",
        "description": "Files that mix CRLF and LF must keep their line endings.",
        "severity": "block",
        "event": [
          "pre_edit",
          "pre_commit"
        ],
        "match": {
          "predicates": [
            "line_endings_changed",
            {
              "name": "mixed_line_endings",
              "on": "original"
            }
          ]
        },
        "message": "This file mixes CRLF and LF on purpose and the change normalizes that. Keep the original line endings and change only the lines you mean to change.",
        "tests": {
          "block": [
            {
              "path": "tools/runner.py",
              "original": "a = 1\r\nb = 2\nc = 3\r\n",
              "content": "a = 1\nb = 2\nc = 4\n"
            },
            {
              "event": "pre_commit",
              "path": "tools/store.py",
              "original": "x\r\ny\nz\r\n",
              "content": "x\r\ny\r\nz\r\n"
            }
          ],
          "pass": [
            {
              "path": "tools/runner.py",
              "original": "a = 1\r\nb = 2\nc = 3\r\n",
              "content": "a = 1\r\nb = 2\nc = 4\r\n"
            },
            {
              "path": "README.md",
              "original": "one\ntwo\n",
              "content": "one\r\ntwo\r\n"
            },
            {
              "path": "tools/new.py",
              "content": "a\r\nb\n"
            }
          ]
        }
      }
    ]
  },
  "no-keys-in-packages": {
    "guards": [
      {
        "id": "no-secrets-in-files",
        "description": "Credential-like strings do not belong in files that get shared, templates included.",
        "severity": "block",
        "event": [
          "pre_edit",
          "pre_commit"
        ],
        "match": {
          "predicates": [
            "contains_secret_like"
          ]
        },
        "message": "This text contains something that looks like an API key or token. Read it from the environment; the value belongs in the local .env, which the user maintains and which is never shipped.",
        "tests": {
          "block": [
            {
              "path": "dist/config.json",
              "content": "{\"api_key\": \"q8Zr2Lx9Wv4Tn7Kp3Hs6Jd1Fm5Bc0Yg\"}\n"
            },
            {
              "event": "pre_commit",
              "path": "package/settings.py",
              "content": "TOKEN = \"Zx81Qw7Er6Ty5Ui4Op3As2Df\"\n"
            },
            {
              "event": "pre_commit",
              "path": ".env.example",
              "content": "API_KEY=q8Zr2Lx9Wv4Tn7Kp3Hs6Jd1Fm5Bc0Yg\n"
            }
          ],
          "pass": [
            {
              "path": "package/settings.py",
              "content": "API_KEY = os.environ[\"API_KEY\"]\n"
            },
            {
              "path": ".env.example",
              "content": "API_KEY=your-api-key-here\n"
            }
          ]
        }
      },
      {
        "id": "no-secret-files",
        "description": "Secret files such as .env and private keys are neither written by the agent nor committed.",
        "severity": "block",
        "event": [
          "pre_edit",
          "pre_commit"
        ],
        "match": {
          "path": [
            ".env",
            ".env.*",
            "*.pem",
            "id_rsa",
            "id_dsa",
            "id_ecdsa",
            "id_ed25519"
          ],
          "path_not": [
            ".env.example",
            ".env.sample",
            ".env.template"
          ]
        },
        "message": "This is a secret file (.env or a private key). It stays on this machine and out of version control. Ask the user to put the value in, keep the file in .gitignore, and commit .env.example with placeholders.",
        "tests": {
          "block": [
            {
              "path": ".env",
              "content": "API_KEY=local-value\n"
            },
            {
              "event": "pre_commit",
              "path": "app/.env.local",
              "content": "DEBUG=1\n"
            },
            {
              "event": "pre_commit",
              "path": ".env.production",
              "content": "DB_HOST=db.internal.test\n"
            },
            {
              "event": "pre_commit",
              "path": "certs/server.pem",
              "content": "certificate data\n"
            },
            {
              "path": "deploy/id_rsa",
              "content": "key data\n"
            }
          ],
          "pass": [
            {
              "path": ".env.example",
              "content": "API_KEY=your-api-key-here\n"
            },
            {
              "event": "pre_commit",
              "path": "app/.env.sample",
              "content": "API_KEY=\n"
            },
            {
              "event": "pre_commit",
              "path": ".env.template",
              "content": "API_KEY=changeme\n"
            },
            {
              "event": "pre_commit",
              "path": "deploy/id_rsa.pub",
              "content": "public key data\n"
            },
            {
              "path": "docs/env.md",
              "content": "How to fill in .env\n"
            }
          ]
        }
      },
      {
        "id": "no-env-in-archives",
        "description": "Archives must not include the local .env file.",
        "severity": "block",
        "event": [
          "pre_tool"
        ],
        "match": {
          "command": "\\b(zip|tar|7z|Compress-Archive|npm\\s+pack)\\b[^\\n]*\\.env\\b(?!\\.(?:example|sample|template)\\b)",
          "command_not": "--exclude[= ]\\S*\\.env|-x\\s+\\S*\\.env"
        },
        "message": "The archive would include .env with local keys. Leave it out (for example --exclude=.env) and ship .env.example instead.",
        "tests": {
          "block": [
            {
              "command": "zip -r release.zip src .env"
            },
            {
              "tool": "PowerShell",
              "command": "Compress-Archive -Path .env,src -DestinationPath out.zip"
            },
            {
              "command": "tar czf app.tgz src .env.local"
            }
          ],
          "pass": [
            {
              "command": "zip -r release.zip src README.md"
            },
            {
              "command": "tar czf app.tgz --exclude=.env src"
            },
            {
              "command": "zip -r release.zip src .env.example"
            },
            {
              "command": "tar czf app.tgz src .env.sample .env.template"
            },
            {
              "command": "cat .env"
            }
          ]
        }
      }
    ]
  },
  "image-server-free": {
    "guards": [
      {
        "id": "image-server-no-free",
        "description": "The /free endpoint of the shared image server unloads all models.",
        "severity": "block",
        "event": [
          "pre_tool"
        ],
        "match": {
          "command": "(?i)https?://\\S+/free\\b"
        },
        "message": "Calling /free unloads every model on the shared image server for all users. Wait for the queue to drain or ask the owner instead.",
        "tests": {
          "block": [
            {
              "command": "curl -X POST http://localhost:9000/free -d '{\"unload_models\": true}'"
            },
            {
              "tool": "PowerShell",
              "command": "Invoke-RestMethod -Method Post -Uri http://localhost:9000/free"
            },
            {
              "tool": "mcp__fetch__fetch",
              "command": "{\"method\": \"POST\", \"url\": \"http://localhost:9000/free\"}"
            }
          ],
          "pass": [
            {
              "command": "curl http://localhost:9000/queue"
            },
            {
              "command": "curl https://example.org/freedom"
            },
            {
              "command": "free -h"
            }
          ]
        }
      },
      {
        "id": "image-server-no-free-loose",
        "description": "Looser variant a model might propose; its own tests show it is too broad.",
        "severity": "block",
        "event": [
          "pre_tool"
        ],
        "match": {
          "command": "/free"
        },
        "message": "Do not call /free on the image server.",
        "tests": {
          "block": [
            {
              "command": "curl -X POST http://localhost:9000/free"
            }
          ],
          "pass": [
            {
              "command": "curl https://example.org/freedom"
            }
          ]
        }
      }
    ]
  },
  "backup-duplicates": {
    "guards": [
      {
        "id": "no-class-files-in-backups",
        "description": "No script copies with class declarations inside backup folders of the project.",
        "severity": "block",
        "event": [
          "pre_edit",
          "pre_commit"
        ],
        "match": {
          "path": [
            "**/backup*/**",
            "**/*_backup/**"
          ],
          "content": "^\\s*(class_name|class)\\s+\\w+"
        },
        "message": "Backup copies inside the project declare the same classes twice. Put the backup outside the project tree or rely on version control.",
        "tests": {
          "block": [
            {
              "path": "backup_old/scripts/player.gd",
              "content": "extends Node\nclass_name Player\n"
            },
            {
              "event": "pre_commit",
              "path": "src/backups/models.py",
              "content": "class User:\n    pass\n"
            }
          ],
          "pass": [
            {
              "path": "scripts/player.gd",
              "content": "extends Node\nclass_name Player\n"
            },
            {
              "path": "backup_old/notes.txt",
              "content": "old notes\n"
            }
          ]
        }
      }
    ]
  },
  "double-encoding": {
    "guards": [
      {
        "id": "no-double-encoded-utf8",
        "description": "Text must not contain UTF-8 that was decoded as cp1252 and encoded again.",
        "severity": "block",
        "event": [
          "pre_edit",
          "pre_commit"
        ],
        "match": {
          "predicates": [
            "utf8_double_encoded"
          ]
        },
        "message": "The new text contains mojibake such as 'Ã¼' for 'ü'. Read and write the file as UTF-8 and fix the broken characters.",
        "tests": {
          "block": [
            {
              "path": "scripts/greeting.py",
              "content": "print('GrÃ¼ezi')\n"
            },
            {
              "path": "docs/notes.md",
              "content": "Itâ€™s done\n"
            }
          ],
          "pass": [
            {
              "path": "scripts/greeting.py",
              "content": "print('Grüezi')\n"
            },
            {
              "path": "docs/price.md",
              "content": "Price: 5 € or 4.50 £, façade, naïve\n"
            }
          ]
        }
      }
    ]
  },
  "answer-style": {
    "guards": [],
    "skip_reason": "communication preference, nothing to check mechanically"
  }
}
